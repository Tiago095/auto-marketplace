@using AutoMatch.Models.ViewModel

@model SellerFormViewModel
@{
    ViewData["Title"] = "Seller Certification";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
}

<link rel="stylesheet" href="~/css/form.css" />
<link rel="stylesheet" href="~/css/listings.css" />
<link rel="stylesheet" href="~/css/footer.css" />
<link rel="stylesheet" href="~/css/user-dropdown.css" />

<!-- Floating Header (same as MyListings) -->
<div class="floating-header floating-header-dark">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="@Url.Action("Index", "Home")" class="nav-btn">Home</a>
        <a href="@Url.Action("About", "Home")" class="nav-btn">About</a>
        <a href="@Url.Action("Contact", "Home")" class="nav-btn">Contact</a>

        @if (username == null)
        {
            <a href="/Account/Login" class="nav-btn signin">Sign In</a>
        }
        else
        {
            <div class="user-menu-container">
                <div class="user-badge" id="userMenuBtn">
                    <span class="user-name">@username</span>

                    @if (!string.IsNullOrEmpty(Context.Session.GetString("UserProfileImageUrl")))
                    {
                        <img src="@Context.Session.GetString("UserProfileImageUrl")" class="user-avatar" />
                    }
                    else
                    {
                        <div class="user-avatar">@initial</div>
                    }
                </div>

                <div class="user-dropdown" id="userDropdown">
                    <a href="/Account/Profile">Profile</a>
                    <a href="/Listings/MyListings">My Listings</a>
                    <a href="/Dashboard/Index">Dashboard</a>
                    <a href="/Account/Logout" style="color: red;">Logout</a>
                </div>
            </div>
        }
    </div>
</div>


<form asp-action="SellerForms" method="post">
    @Html.AntiForgeryToken()

    <div class="seller-cert-page">
        <div class="seller-cert-header">
            <h1>Seller Certification</h1>
        </div>

        <div class="seller-cert-layout">
            <!-- Coluna esquerda: Details -->
            <section class="seller-card seller-card-left">
                <div class="seller-card-header">
                    <div class="seller-card-title-group">
                        <h2>Details</h2>
                        <p class="seller-step-label">Step 1 of 2</p>
                    </div>
                    <div class="seller-progress">
                        <div class="seller-progress-bar seller-progress-bar-left"></div>
                    </div>
                </div>

                <div class="seller-card-body">
                    <div class="seller-field-group">
                        <label>Are you selling occasionally or regularly?</label>
                        <select asp-for="SellingType" required>
                            <option value="">Select an option</option>
                            <option value="Individual">Individual</option>
                            <option value="Professional">Professional</option>
                        </select>
                    </div>

                    <div class="seller-field-group">
                        <label>NIF</label>
                        <input asp-for="DocumentNumber" type="text" placeholder="Document number" pattern="\d{9}" maxlength="9" />
                        <span asp-validation-for="DocumentNumber" class="text-danger"></span>
                    </div>

                    <div class="seller-field-group">
                        <label>Phone Number</label>
                        <input asp-for="PhoneNumber" type="text" placeholder="Phone number" required pattern="\d{9}" maxlength="9" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="seller-address-title">Address</div>

                    <div class="seller-field-row">
                        <div class="seller-field-group">
                            <label>City</label>
                            <select asp-for="PostalCode" asp-items="(IEnumerable<SelectListItem>)ViewBag.PostalCodeOptions" required id="PostalCodeSelect"></select>
                        </div>
                        <div class="seller-field-group">
                            <label>Postal Code</label>
                            <input id="PostalCodeDisplay" type="text" placeholder="Postal Code" value="@Model.PostalCode" readonly />
                        </div>
                    </div>

                    <div class="seller-field-group">
                        <label>Preferred Contact Method</label>
                        <select asp-for="PreferredContactMethod" required>
                            <option value="">Select an option</option>
                            <option value="Email">Email</option>
                            <option value="Phone">Phone</option>
                            <option value="SMS">SMS</option>
                        </select>
                    </div>
                </div>
            </section>

            <!-- Coluna direita: Verification -->
            <section class="seller-card seller-card-right">
                <div class="seller-card-header">
                    <div class="seller-card-title-group">
                        <h2>Verification</h2>
                        <p class="seller-step-label">Step 2 of 2</p>
                    </div>
                    <div class="seller-progress">
                        <div class="seller-progress-bar seller-progress-bar-right"></div>
                    </div>
                </div>

                <div class="seller-card-body">
                    <div class="seller-summary-card">
                        <div class="seller-summary-header">
                            <div>
                                <h3>Summary</h3>
                            </div>
                            <div class="seller-summary-user">
                                <div class="seller-summary-avatar"></div>
                                <span class="seller-summary-username">@(Model.UserName ?? username)</span>
                            </div>
                        </div>

                        <div class="seller-summary-content">
                            <div class="seller-summary-row">
                                <span class="seller-summary-label">Full Name</span>
                                <span class="seller-summary-value">@Model.FullName</span>
                            </div>
                            <div class="seller-summary-row">
                                <span class="seller-summary-label">Email</span>
                                <span class="seller-summary-value">@Model.Email</span>
                            </div>
                            <div class="seller-summary-row">
                                <span class="seller-summary-label">Phone Number</span>
                                <span class="seller-summary-value">@Model.PhoneNumber</span>
                            </div>
                        </div>
                    </div>

                    <div class="seller-terms">
                        <label class="seller-checkbox-label">
                            <input asp-for="AcceptTerms" type="checkbox" required />
                            <span>I agree to the Seller Terms &amp; Conditions</span>
                        </label>
                        <span asp-validation-for="AcceptTerms" class="text-danger"></span>
                    </div>

                    <div class="seller-verification-footer">
                        <div class="seller-review-info">
                            Your account will be reviewed within 24-48h
                        </div>
                        <button type="submit" class="seller-submit-btn">Submit Application</button>
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>

@await Html.PartialAsync("_Footer")

@if (TempData["SellerFormSubmitted"] != null)
{
    <div class="success-popup" id="successPopup" style="display: flex;">
        <div class="success-popup-content">
            <i class="fa-solid fa-check-circle"></i>
            <h3>Application Sent Successfully!</h3>
            <p>@TempData["SellerFormSubmitted"]</p>
            <button onclick="closeSuccessPopup()">OK</button>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("click", function (e) {
            const btn = document.getElementById("userMenuBtn");
            const dropdown = document.getElementById("userDropdown");
            const container = btn?.closest('.user-menu-container');

            if (!btn || !dropdown) return;

            if (btn.contains(e.target)) {
                dropdown.classList.toggle("show");
                if (container) {
                    container.classList.toggle("open");
                }
            } else if (!dropdown.contains(e.target)) {
                dropdown.classList.remove("show");
                if (container) {
                    container.classList.remove("open");
                }
            }
        });

        document.addEventListener("DOMContentLoaded", function () {
            const citySelect = document.getElementById("PostalCodeSelect");
            const postalDisplay = document.getElementById("PostalCodeDisplay");

            if (!citySelect || !postalDisplay) return;

            const syncPostal = () => {
                const selected = citySelect.options[citySelect.selectedIndex];
                if (!selected || !selected.value) {
                    postalDisplay.value = "";
                } else {
                    postalDisplay.value = selected.value;
                }
            };

            syncPostal();

            citySelect.addEventListener("change", syncPostal);
        });

        // Show success popup if it exists
        document.addEventListener("DOMContentLoaded", function () {
            const popup = document.getElementById("successPopup");
            if (popup) {
                popup.style.display = "flex";
            }
        });

        function closeSuccessPopup() {
            const popup = document.getElementById("successPopup");
            if (popup) {
                popup.style.display = "none";
                // Redirect to MyListings after closing popup
                window.location.href = "/Listings/MyListings";
            }
        }
    </script>
}