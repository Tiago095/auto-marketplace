@using System.Text.Json
@model AutoMatch.Models.ViewModels.VehicleResultsViewModel
@{
    ViewData["Title"] = "Vehicle Results";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
    var profileImageUrl = Context.Session.GetString("UserProfileImageUrl");
}

<!-- Floating Header (same as other pages) -->
<div class="floating-header floating-header-dark">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="@Url.Action("Index", "Home")" class="nav-btn">Home</a>
        <a href="@Url.Action("About", "Home")" class="nav-btn">About</a>
        <a href="@Url.Action("Contact", "Home")" class="nav-btn">Contact</a>

        @if (username == null)
        {
            <a href="/Account/Login" class="nav-btn signin">Sign In</a>
        }
        else
        {
            <div class="user-menu-container">
                <div class="user-badge" id="userMenuBtn">
                    <span class="user-name">@username</span>
                    @if (!string.IsNullOrEmpty(profileImageUrl))
                    {
                        <img src="@profileImageUrl" class="user-avatar" />
                    }
                    else
                    {
                        <div class="user-avatar">@initial</div>
                    }
                </div>

                <div class="user-dropdown" id="userDropdown">
                    <a href="/Account/Profile">Profile</a>
                    <a href="/Anuncios/Create">Create Ad</a>
                    <a href="/Dashboard/Index">Dashboard</a>
                    <a href="/Account/Logout" style="color: red;">Logout</a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Results Section -->
<section class="results-section">
    <div class="results-container">
        <h1 class="results-title">Vehicle Results</h1>
        <p class="results-subtitle">Browse through the best cars in the market</p>

        <!-- Filter Bar -->
        <div class="filters-wrapper">
            <form method="get" action="/Vehicle/Results" id="filterForm">
                <div class="filter-row">
                    <select name="brand" id="brandFilter" class="filter-select">
                        <option value="">Brand</option>
                        @foreach (var b in Model.AvailableBrands)
                        {
                            <option value="@b" selected="@(b == Model.SelectedBrand ? "selected" : null)">@b</option>
                        }
                    </select>

                    <select name="model" id="modelFilter" class="filter-select">
                        <option value="">Model</option>
                        @if (!string.IsNullOrEmpty(Model.SelectedBrand) &&
                             Model.BrandModels.TryGetValue(Model.SelectedBrand, out var modelsForBrand))
                        {
                            foreach (var m in modelsForBrand)
                            {
                                <option value="@m" selected="@(m == Model.SelectedModel ? "selected" : null)">@m</option>
                            }
                        }
                    </select>

                    <select name="year" class="filter-select">
                        <option value="">Year</option>
                        @for (int y = 2025; y >= 2015; y--)
                        {
                            <option value="@y" selected="@(Model.SelectedYear == y ? "selected" : null)">@y</option>
                        }
                    </select>

                    <select name="maxPrice" class="filter-select">
                        <option value="">Price</option>
                        <option value="20000" selected="@(Model.SelectedMaxPrice == 20000 ? "selected" : null)">Up to 20,000€</option>
                        <option value="30000" selected="@(Model.SelectedMaxPrice == 30000 ? "selected" : null)">Up to 30,000€</option>
                        <option value="40000" selected="@(Model.SelectedMaxPrice == 40000 ? "selected" : null)">Up to 40,000€</option>
                        <option value="50000" selected="@(Model.SelectedMaxPrice == 50000 ? "selected" : null)">Up to 50,000€</option>
                    </select>

                    <select name="sort" class="filter-select sort-select">
                        <option value="price-low-high" selected="@(Model.SelectedSort == "price-low-high" || string.IsNullOrEmpty(Model.SelectedSort) ? "selected" : null)">Sort by: Price (Low-High)</option>
                        <option value="price-high-low" selected="@(Model.SelectedSort == "price-high-low" ? "selected" : null)">Price (High-Low)</option>
                        <option value="year-new-old" selected="@(Model.SelectedSort == "year-new-old" ? "selected" : null)">Year (New-Old)</option>
                        <option value="year-old-new" selected="@(Model.SelectedSort == "year-old-new" ? "selected" : null)">Year (Old-New)</option>
                        <option value="mileage-low-high" selected="@(Model.SelectedSort == "mileage-low-high" ? "selected" : null)">Mileage (Low-High)</option>
                    </select>
                </div>

                <div class="filter-row">
                    <select name="maxMileage" class="filter-select">
                        <option value="">Mileage</option>
                        <option value="50000" selected="@(Model.SelectedMaxMileage == 50000 ? "selected" : null)">Up to 50,000 km</option>
                        <option value="100000" selected="@(Model.SelectedMaxMileage == 100000 ? "selected" : null)">Up to 100,000 km</option>
                        <option value="150000" selected="@(Model.SelectedMaxMileage == 150000 ? "selected" : null)">Up to 150,000 km</option>
                    </select>

                    <select name="fuelType" class="filter-select">
                        <option value="">Fuel Type</option>
                        <option value="Electric" selected="@(Model.SelectedFuelType == "Electric" ? "selected" : null)">Electric</option>
                        <option value="Petrol" selected="@(Model.SelectedFuelType == "Petrol" ? "selected" : null)">Petrol</option>
                        <option value="Diesel" selected="@(Model.SelectedFuelType == "Diesel" ? "selected" : null)">Diesel</option>
                        <option value="Hybrid" selected="@(Model.SelectedFuelType == "Hybrid" ? "selected" : null)">Hybrid</option>
                    </select>

                    <select name="transmission" class="filter-select">
                        <option value="">Transmission</option>
                        <option value="Automatic" selected="@(Model.SelectedTransmission == "Automatic" ? "selected" : null)">Automatic</option>
                        <option value="Manual" selected="@(Model.SelectedTransmission == "Manual" ? "selected" : null)">Manual</option>
                    </select>

                    <select name="bodyType" class="filter-select">
                        <option value="">Body Type</option>
                        <option value="Sedan" selected="@(Model.SelectedBodyType == "Sedan" ? "selected" : null)">Sedan</option>
                        <option value="SUV" selected="@(Model.SelectedBodyType == "SUV" ? "selected" : null)">SUV</option>
                        <option value="Coupe" selected="@(Model.SelectedBodyType == "Coupe" ? "selected" : null)">Coupe</option>
                        <option value="Hatchback" selected="@(Model.SelectedBodyType == "Hatchback" ? "selected" : null)">Hatchback</option>
                    </select>

                    <button type="submit" class="search-button">
                        <span>Search</span>
                        <i class="fa fa-search"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Vehicle Grid -->
        <div class="vehicle-grid">
            @if (Model.Vehicles != null && Model.Vehicles.Any())
            {
                @foreach (var vehicle in Model.Vehicles)
                {
                    <a href="@Url.Action("Details", "Vehicle", new { id = vehicle.Id })" class="vehicle-card-link">
                        <div class="vehicle-card">
                            <div class="vehicle-image-placeholder">
                                <!-- Placeholder cinza para imagem -->
                            </div>
                            <div class="vehicle-info">
                                <h3 class="vehicle-title">@vehicle.Brand @vehicle.Model</h3>
                                <p class="vehicle-year">@vehicle.Year</p>
                                <p class="vehicle-price">@vehicle.Price.ToString("N0")€</p>
                                <div class="vehicle-badges">
                                    <span class="badge">@vehicle.FuelType</span>
                                    <span class="badge">@vehicle.Transmission</span>
                                </div>
                                <p class="vehicle-mileage">@vehicle.Mileage.ToString("N0")km</p>
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="no-results">
                    <p>No vehicles found matching your criteria.</p>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // USER DROPDOWN TOGGLE
        document.addEventListener("click", function (e) {
            const btn = document.getElementById("userMenuBtn");
            const dropdown = document.getElementById("userDropdown");

            if (!btn || !dropdown) return;

            if (btn.contains(e.target)) {
                dropdown.classList.toggle("show");
            }
            else if (!dropdown.contains(e.target)) {
                dropdown.classList.remove("show");
            }
        });

        // Brand-Model dependency (loaded from database)
        const models = @Html.Raw(JsonSerializer.Serialize(Model.BrandModels));

        const brandFilter = document.getElementById("brandFilter");
        const modelFilter = document.getElementById("modelFilter");

        brandFilter.addEventListener("change", function () {
            const selectedBrand = this.value;
            modelFilter.innerHTML = '<option value="">Model</option>';
            
            if (selectedBrand && models[selectedBrand]) {
                modelFilter.disabled = false;
                models[selectedBrand].forEach(model => {
                    const option = document.createElement("option");
                    option.value = model;
                    option.textContent = model;
                    modelFilter.appendChild(option);
                });
            } else {
                modelFilter.disabled = true;
            }
        });

        // Auto-submit apenas no sort
        document.querySelector('.sort-select')?.addEventListener('change', function() {
            document.getElementById('filterForm').submit();
        });
    </script>
}
