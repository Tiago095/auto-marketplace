@model AutoMatch.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
    var profileImageUrl = Context.Session.GetString("UserProfileImageUrl");
}
<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="stylesheet" href="~/css/listings.css" />
<link rel="stylesheet" href="~/css/footer.css" />
<link rel="stylesheet" href="~/css/user-dropdown.css" />

<!-- Floating Header -->
<div class="floating-header floating-header-dark">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="@Url.Action("Index", "Home")" class="nav-btn">Home</a>
        <a href="@Url.Action("About", "Home")" class="nav-btn">About</a>
        <a href="@Url.Action("Contact", "Home")" class="nav-btn">Contact</a>
        <div class="user-menu-container">
            <div class="user-badge" id="userMenuBtn">
                <span class="user-name">@username</span>
                @if (!string.IsNullOrEmpty(profileImageUrl))
                {
                    <img src="@profileImageUrl" class="user-avatar" />
                }
                else
                {
                    <div class="user-avatar">@initial</div>
                }
            </div>

            <div class="user-dropdown" id="userDropdown">
                <a href="/Account/Profile">Profile</a>
                <a href="/Listings/MyListings">My Listings</a>
                <a href="/DashBoard/Index">Dashboard</a>
                <a href="/Account/Logout" style="color: red;">Logout</a>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-page">
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-logo-dot"></div>
            <ul class="sidebar-menu">
                <li>
                    <button class="sidebar-btn active" type="button" data-target="/DashBoard/Index">
                        <span class="icon"><i class="fa-solid fa-gauge"></i></span>
                        <span>Dashboard</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Bookings">
                        <span class="icon"><i class="fa-regular fa-calendar-check"></i></span>
                        <span>Bookings</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Messages">
                        <span class="icon"><i class="fa-regular fa-message"></i></span>
                        <span>Messages</span>
                        @if (ViewBag.UnreadMessagesCount != null && (int)ViewBag.UnreadMessagesCount > 0)
                        {
                            <span class="sidebar-badge">@ViewBag.UnreadMessagesCount</span>
                        }
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Notifications">
                        <span class="icon"><i class="fa-regular fa-bell"></i></span>
                        <span>Notifications</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Documents">
                        <span class="icon"><i class="fa-regular fa-folder-open"></i></span>
                        <span>Documents</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Sales">
                        <span class="icon"><i class="fa-solid fa-chart-column"></i></span>
                        <span>Sales</span>
                    </button>
                </li>
                @{
                    var userId = Context.Session.GetInt32("UserId");
                    bool isAdmin = false;
                }

                @inject AutoMatch.Data.AutoMatchContext _context

                @{
                    if (userId != null)
                    {
                        isAdmin = _context.Administradores.Any(a => a.Id_User == userId);
                    }
                }

                @if (isAdmin)
                {
                    <li>
                        <div class="sidebar-bottom">
                             <button class="sidebar-btn" type="button" data-target="/Admin/DashAdmin">
                                 <i class="fa-solid fa-user-shield"></i> Admin Dashboard
                        </div>
                    </li>
                }
            </ul>
        </aside>

        <main class="dashboard-main">
            <section class="welcome-section">
                <h1>Welcome Back!</h1>
                <p class="subtitle">Pick up where you left off</p>

                <div class="grid-row">
                    <div class="card quick-stats">
                        <h2>Quick Stats</h2>
                        <div class="stats-grid">
                            <a href="/DashBoard/Bookings" class="stat-item" style="text-decoration: none; color: inherit; display: flex; align-items: center; cursor: pointer;">
                                <div class="stat-icon circle"></div>
                                <div class="stat-text">
                                    <span class="stat-number">@Model.PendingBookings</span>
                                    <span class="stat-label">Pending Bookings</span>
                                </div>
                            </a>
                            <a href="/DashBoard/Messages" class="stat-item" style="text-decoration: none; color: inherit; display: flex; align-items: center; cursor: pointer;">
                                <div class="stat-icon"></div>
                                <div class="stat-text">
                                    <span class="stat-number">@Model.UnreadMessages</span>
                                    <span class="stat-label">Unread Messages</span>
                                </div>
                            </a>
                            <a href="/DashBoard/Notifications" class="stat-item" style="text-decoration: none; color: inherit; display: flex; align-items: center; cursor: pointer;">
                                <div class="stat-icon"></div>
                                <div class="stat-text">
                                    <span class="stat-number">@Model.NewNotifications</span>
                                    <span class="stat-label">New Notifications</span>
                                </div>
                            </a>
                            <div class="stat-item">
                                <div class="stat-icon"></div>
                                <div class="stat-text">
                                    <span class="stat-number">@Model.FiltersSaved</span>
                                    <span class="stat-label">Filters Saved</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card messages">
                        <h2>Recent Messages</h2>
                        @if (Model.RecentMessages.Any())
                        {
                            foreach (var msg in Model.RecentMessages)
                            {
                                var messageLink = msg.OutroParticipanteId.HasValue 
                                    ? $"/DashBoard/Messages?vendedorId={msg.OutroParticipanteId.Value}" 
                                    : "/DashBoard/Messages";
                                <a href="@messageLink" style="text-decoration: none; color: inherit; display: block;">
                                    <div class="message-item" style="cursor: pointer;">
                                        <div class="avatar">
                                            @if (!string.IsNullOrEmpty(msg.ProfileImageUrl))
                                            {
                                                <img src="@msg.ProfileImageUrl" alt="@msg.NomeRemetente" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                                            }
                                            else
                                            {
                                                <span style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: white; font-weight: 600; font-size: 14px;">
                                                    @(msg.NomeRemetente?.Substring(0, 1).ToUpper() ?? "?")
                                                </span>
                                            }
                                        </div>
                                    <div class="message-content">
                                        <div class="message-header">
                                            <span class="name">@msg.NomeRemetente</span>
                                            <span class="time">@msg.Data.ToString("g")</span>
                                        </div>
                                        <p class="message-preview">@msg.Texto</p>
                                    </div>
                                </div>
                                </a>
                            }
                        }
                        else
                        {
                            <p>No recent messages.</p>
                        }
                    </div>
</div>

                <div class="grid-row">
                    <div class="card latest-booking">
                        <h2>Latest Bookings</h2>
                        @if (Model.LatestBooking != null)
                        {
                            <div class="booking-content">
                                <div class="booking-image">
                                    @if (!string.IsNullOrEmpty(Model.LatestBooking.CarImageUrl))
                                    {
                                        <img src="@Model.LatestBooking.CarImageUrl" alt="@Model.LatestBooking.CarTitle" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" />
                                    }
                                    else
                                    {
                                        <div style="width: 100%; height: 100%; background: #e0e0e0; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #999;">
                                            <i class="fa-solid fa-car" style="font-size: 32px;"></i>
                                        </div>
                                    }
                                </div>
                        <div class="booking-info">
                                    <h3>@Model.LatestBooking.CarTitle</h3>
                                    <p>Date: @Model.LatestBooking.DataInicio.ToString("dd MMMM yyyy")</p>
                                    <p>Time: @Model.LatestBooking.DataInicio.ToString("HH:mm") - @Model.LatestBooking.DataFim.ToString("HH:mm")</p>
                                    <a href="/DashBoard/Bookings" class="btn-view" style="text-decoration: none; display: inline-block;">View More</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p>No bookings yet.</p>
                        }
                    </div>

                    <div class="card notifications">
                        <h2>Notifications</h2>
                        <ul class="notification-list">
                            @if (Model.Notifications.Any())
                            {
                                foreach (var n in Model.Notifications)
                                {
                                    string notificationLink = "#";
                                    if (n.Tipo == "Mensagem" && n.OutroParticipanteId.HasValue)
                                    {
                                        notificationLink = $"/DashBoard/Messages?vendedorId={n.OutroParticipanteId.Value}";
                                    }
                                    else if (n.Tipo == "Booking")
                                    {
                                        notificationLink = "/DashBoard/Bookings";
                                    }
                                    <li style="cursor: pointer;" onclick="window.location.href='@notificationLink'">
                                        <p>@n.Texto</p>
                                        <span class="time">@n.Data.ToString("g")</span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li><p>No notifications.</p></li>
                            }
                        </ul>
                    </div>
                </div>
            </section>
        </main>
    </div>
</div>

@await Html.PartialAsync("_Footer")

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // user dropdown
            document.addEventListener("click", function (e) {
                const btn = document.getElementById("userMenuBtn");
                const dropdown = document.getElementById("userDropdown");
                const container = btn?.closest('.user-menu-container');

                if (!btn || !dropdown) return;

                if (btn.contains(e.target)) {
                    dropdown.classList.toggle("show");
                    if (container) {
                        container.classList.toggle("open");
                    }
                }
                else if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove("show");
                    if (container) {
                        container.classList.remove("open");
                    }
                }
            });

            // sidebar + transicao
            document.querySelectorAll('.sidebar-btn[data-target]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = this.getAttribute('data-target');
                    var main = document.querySelector('.dashboard-main');
                    if (!url) return;
                    if (main) {
                        main.classList.add('page-transition-out');
                        setTimeout(function () {
                            window.location.href = url;
                        }, 220);
                    } else {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
}
