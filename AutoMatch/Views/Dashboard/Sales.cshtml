@model AutoMatch.Models.ViewModels.SalesViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Sales";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="floating-header">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="/Home/Index" class="nav-btn">Home</a>
        <a href="/Home/About" class="nav-btn">About</a>
        <a href="/Home/Contact" class="nav-btn">Contact</a>
            <div class="user-menu-container">
                <div class="user-badge" id="userMenuBtn">
                    <span class="user-name">@username</span>
                    <div class="user-avatar">@initial</div>
                </div>

                <div class="user-dropdown" id="userDropdown">
                    <a href="/Account/Profile">Profile</a>
                    <a href="/Anuncios/Create">Create Ad</a>
                    <a href="/DashBoard/Index">Dashboard</a>
                    <a href="/Account/Logout" style="color: red;">Logout</a>
                </div>
            </div>
     </div>
</div>

<div class="dashboard-page">
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-logo-dot"></div>
            <ul class="sidebar-menu">
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Index">
                        <span class="icon"><i class="fa-solid fa-gauge"></i></span>
                        <span>Dashboard</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Bookings">
                        <span class="icon"><i class="fa-regular fa-calendar-check"></i></span>
                        <span>Bookings</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Messages">
                        <span class="icon"><i class="fa-regular fa-message"></i></span>
                        <span>Messages</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Notifications">
                        <span class="icon"><i class="fa-regular fa-bell"></i></span>
                        <span>Notifications</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Documents">
                        <span class="icon"><i class="fa-regular fa-folder-open"></i></span>
                        <span>Documents</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn active" type="button" data-target="/DashBoard/Sales">
                        <span class="icon"><i class="fa-solid fa-chart-column"></i></span>
                        <span>Sales</span>
                    </button>
                </li>
            </ul>
        </aside>

        <main class="dashboard-main sales-main">
            <div class="sales-wrapper-card">
                <h1>Sales Overview</h1>
                <p class="subtitle">Manage you sales, performance and revenue</p>

            <form asp-action="Sales" asp-controller="DashBoard" method="get" class="sales-header-actions">
                <div class="sales-filter">
                    <select class="sales-range-select" name="range" onchange="this.form.submit()">
                        <option value="7d" selected="@(Model.SelectedRange == "7d")">Last 7 days</option>
                        <option value="1m" selected="@(Model.SelectedRange == "1m")">Last month</option>
                        <option value="1y" selected="@(Model.SelectedRange == "1y")">Last year</option>
                    </select>
                </div>
            </form>

            <div class="sales-top-grid">
                <div class="card sales-quick">
                    <h2>Quick Stats</h2>
                    <p><strong>@Model.TotalVendasConcluidas</strong> Vendas Concluídas</p>
                    @if (!string.IsNullOrEmpty(Model.TopModel))
                    {
                        <div class="top-model">
                            <h3>Top Model Sold</h3>
                            <p>@Model.TopModel</p>
                            <span>@Model.TopModelUnidades unidades vendidas</span>
                        </div>
                    }
                </div>

                <div class="card sales-chart">
                    <h2>Sales Performance</h2>
                    <div class="chart-container" style="padding: 20px;">
                        <canvas id="salesChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="card sales-table-card">
                <h2>Recent Sales</h2>
                <table class="sales-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Vehicle</th>
                            <th>Value</th>
                            <th>State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentSales != null && Model.RecentSales.Any())
                        {
                            foreach (var s in Model.RecentSales)
                            {
                                <tr>
                                    <td>@s.Data.ToString("dd/MM/yyyy")</td>
                                    <td>@s.Cliente</td>
                                    <td>@s.Veiculo</td>
                                    <td>@s.Valor.ToString("N0") €</td>
                                    <td>@s.Estado</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">No sales yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // dropdown user
            document.addEventListener("click", function (e) {
                const btn = document.getElementById("userMenuBtn");
                const dropdown = document.getElementById("userDropdown");

                if (!btn || !dropdown) return;

                if (btn.contains(e.target)) {
                    dropdown.classList.toggle("show");
                }
                else if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove("show");
                }
            });

            // sidebar + transicao
            document.querySelectorAll('.sidebar-btn[data-target]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = this.getAttribute('data-target');
                    var main = document.querySelector('.dashboard-main');
                    if (!url) return;
                    if (main) {
                        main.classList.add('page-transition-out');
                        setTimeout(function () {
                            window.location.href = url;
                        }, 220);
                    } else {
                        window.location.href = url;
                    }
                });
            });

            // Gráfico de vendas
            function initChart() {
                var ctx = document.getElementById('salesChart');
                if (!ctx) {
                    console.error('Canvas não encontrado!');
                    return;
                }

                // Verificar se Chart está disponível
                if (typeof Chart === 'undefined') {
                    console.error('Chart.js não está carregado!');
                    setTimeout(initChart, 100);
                    return;
                }

                @{
                    var jsonOptions = new System.Text.Json.JsonSerializerOptions 
                    { 
                        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase 
                    };
                    var salesDataJson = System.Text.Json.JsonSerializer.Serialize(Model.MonthlySales ?? new List<AutoMatch.Models.ViewModels.MonthlySalesData>(), jsonOptions);
                }
                var monthlySalesData = @Html.Raw(salesDataJson);
                
                console.log('Dados recebidos:', monthlySalesData);
                
                var labels = [];
                var data = [];
                
                if (monthlySalesData && monthlySalesData.length > 0) {
                    labels = monthlySalesData.map(function(item) { 
                        return item.month || item.Month || ''; 
                    });
                    data = monthlySalesData.map(function(item) { 
                        return item.count || item.Count || 0; 
                    });
                } else {
                    // Dados de fallback se não houver dados
                    labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                    data = [3, 5, 4, 6, 8, 7, 9, 5, 6, 4, 7, 8];
                }
                
                console.log('Labels:', labels);
                console.log('Data:', data);

                try {
                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Carros Vendidos',
                                data: data,
                                borderColor: 'rgba(74, 222, 128, 1)',
                                backgroundColor: 'rgba(74, 222, 128, 0.1)',
                                borderWidth: 3,
                                fill: true,
                                tension: 0.4,
                                pointBackgroundColor: 'rgba(74, 222, 128, 1)',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointRadius: 5,
                                pointHoverRadius: 7
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: true,
                                    position: 'top',
                                    labels: {
                                        color: '#ffffff',
                                        font: {
                                            size: 13,
                                            weight: 'bold'
                                        },
                                        padding: 15
                                    }
                                },
                                tooltip: {
                                    backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                    titleColor: '#ffffff',
                                    bodyColor: '#ffffff',
                                    borderColor: 'rgba(74, 222, 128, 1)',
                                    borderWidth: 1,
                                    padding: 12,
                                    displayColors: false
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        color: '#888',
                                        font: {
                                            size: 11
                                        },
                                        stepSize: 1
                                    },
                                    grid: {
                                        color: 'rgba(255, 255, 255, 0.08)'
                                    }
                                },
                                x: {
                                    ticks: {
                                        color: '#888',
                                        font: {
                                            size: 11
                                        }
                                    },
                                    grid: {
                                        color: 'rgba(255, 255, 255, 0.08)',
                                        display: false
                                    }
                                }
                            }
                        }
                    });
                    console.log('Gráfico criado com sucesso!');
                } catch (error) {
                    console.error('Erro ao criar gráfico:', error);
                }
            }

            // Aguardar um pouco para garantir que Chart.js está carregado
            if (typeof Chart !== 'undefined') {
                initChart();
            } else {
                setTimeout(initChart, 500);
            }
        });
    </script>
}
