@model AutoMatch.Models.ViewModels.NotificationsViewModel
@{
    ViewData["Title"] = "Notifications";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="floating-header">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="/Home/Index" class="nav-btn">Home</a>
        <a href="/Home/About" class="nav-btn">About</a>
        <a href="/Home/Contact" class="nav-btn">Contact</a>
        <div class="user-menu-container">
            <div class="user-badge" id="userMenuBtn">
                <span class="user-name">@username</span>
                <div class="user-avatar">@initial</div>
            </div>

            <div class="user-dropdown" id="userDropdown">
                <a href="/Account/Profile">Profile</a>
                <a href="/Anuncios/Create">Create Ad</a>
                <a href="/DashBoard/Index">Dashboard</a>
                <a href="/Account/Logout" style="color: red;">Logout</a>
            </div>
        </div>
    </div>
</div>
<div class="dashboard-page">
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-logo-dot"></div>
            <ul class="sidebar-menu">
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Index">
                        <span class="icon"><i class="fa-solid fa-gauge"></i></span>
                        <span>Dashboard</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Bookings">
                        <span class="icon"><i class="fa-regular fa-calendar-check"></i></span>
                        <span>Bookings</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Messages">
                        <span class="icon"><i class="fa-regular fa-message"></i></span>
                        <span>Messages</span>
                        @if (ViewBag.UnreadMessagesCount != null && (int)ViewBag.UnreadMessagesCount > 0)
                        {
                            <span class="sidebar-badge">@ViewBag.UnreadMessagesCount</span>
                        }
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn active" type="button" data-target="/DashBoard/Notifications">
                        <span class="icon"><i class="fa-regular fa-bell"></i></span>
                        <span>Notifications</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Documents">
                        <span class="icon"><i class="fa-regular fa-folder-open"></i></span>
                        <span>Documents</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Sales">
                        <span class="icon"><i class="fa-solid fa-chart-column"></i></span>
                        <span>Sales</span>
                    </button>
                </li>
            </ul>
        </aside>

        <main class="dashboard-main notifications-main">
            <div class="notifications-panel">
                <h1>Notifications</h1>

                <div class="conv-search">
                    <input type="text" id="searchNotif" placeholder="Search notifications..." />
                </div>

                <div class="notif-items" id="notifItems">
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var n in Model.Items)
                        {
                            var isMessage = n.Titulo.Contains("mensagem", StringComparison.OrdinalIgnoreCase);
                            var isBooking = n.Titulo.Contains("reserva", StringComparison.OrdinalIgnoreCase);
                            var isClickable = isMessage || isBooking;
                            
                            string linkUrl = "#";
                            if (isMessage && n.OutroParticipanteId.HasValue)
                            {
                                linkUrl = $"/Dashboard/Messages?vendedorId={n.OutroParticipanteId.Value}";
                            }
                            else if (isBooking)
                            {
                                linkUrl = "/Dashboard/Bookings";
                            }
                            
                            <div class="notif-item @(n.Lida ? "read" : "unread") @(isClickable ? "notif-clickable" : "")" 
                                 @(isClickable ? $"data-link=\"{linkUrl}\"" : "")>
                                <div class="notif-dot"></div>
                                <div class="notif-info">
                                    <div class="notif-title">@n.Titulo</div>
                                    <div class="notif-text">@n.Texto</div>
                                    <div class="notif-meta">@n.Data.ToString("g")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p>No notifications.</p>
                    }
                </div>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // dropdown user
            document.addEventListener("click", function (e) {
                const btn = document.getElementById("userMenuBtn");
                const dropdown = document.getElementById("userDropdown");

                if (!btn || !dropdown) return;

                if (btn.contains(e.target)) {
                    dropdown.classList.toggle("show");
                }
                else if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove("show");
                }
            });

            // sidebar + transition
            document.querySelectorAll('.sidebar-btn[data-target]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = this.getAttribute('data-target');
                    var main = document.querySelector('.dashboard-main');
                    if (!url) return;
                    if (main) {
                        main.classList.add('page-transition-out');
                        setTimeout(function () {
                            window.location.href = url;
                        }, 220);
                    } else {
                        window.location.href = url;
                    }
                });
            });

            // Click em notificações de mensagem para abrir conversa
            document.querySelectorAll('.notif-item.notif-clickable').forEach(function (item) {
                item.addEventListener('click', function () {
                    var link = this.getAttribute('data-link');
                    if (link && link !== '#') {
                        window.location.href = link;
                    }
                });
            });

            // --- Funcionalidade de Search nas Notificações ---
            const searchNotif = document.getElementById('searchNotif');
            const notifItems = document.getElementById('notifItems');
            
            if (searchNotif && notifItems) {
                searchNotif.addEventListener('input', function(e) {
                    const searchTerm = e.target.value.toLowerCase().trim();
                    const notifItemElements = notifItems.querySelectorAll('.notif-item');
                    
                    notifItemElements.forEach(item => {
                        const notifTitle = item.querySelector('.notif-title')?.textContent.toLowerCase() || '';
                        const notifText = item.querySelector('.notif-text')?.textContent.toLowerCase() || '';
                        const matches = notifTitle.includes(searchTerm) || notifText.includes(searchTerm);
                        
                        item.style.display = matches ? '' : 'none';
                    });
                });
            }
        });
    </script>
}
