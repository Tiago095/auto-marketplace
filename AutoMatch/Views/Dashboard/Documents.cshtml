@model AutoMatch.Models.ViewModels.DocumentsViewModel
@{
    ViewData["Title"] = "Documents";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="floating-header">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="/" class="nav-btn">Home</a>
        <a href="/Home/Index#about" class="nav-btn">About</a>
        <a href="/Home/Index#contact" class="nav-btn">Contact</a>

        @if (username == null)
        {
            <a href="/Account/Login" class="nav-btn signin">
                Sign In
            </a>
        }
        else
        {
            <div class="user-menu-container">
                <div class="user-badge" id="userMenuBtn">
                    <span class="user-name">@username</span>
                    <div class="user-avatar">@initial</div>
                </div>

                <div class="user-dropdown" id="userDropdown">
                    <a href="/Account/Profile">Profile</a>
                    <a href="/Anuncios/Create">Create Ad</a>
                    <a href="/DashBoard/Index">Dashboard</a>
                    <a href="/Account/Logout" style="color: red;">Logout</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="dashboard-page">
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-logo-dot"></div>
            <ul class="sidebar-menu">
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Index">
                        <span class="icon"><i class="fa-solid fa-gauge"></i></span>
                        <span>Dashboard</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Bookings">
                        <span class="icon"><i class="fa-regular fa-calendar-check"></i></span>
                        <span>Bookings</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Messages">
                        <span class="icon"><i class="fa-regular fa-message"></i></span>
                        <span>Messages</span>
                        @if (ViewBag.UnreadMessagesCount != null && (int)ViewBag.UnreadMessagesCount > 0)
                        {
                            <span class="sidebar-badge">@ViewBag.UnreadMessagesCount</span>
                        }
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Notifications">
                        <span class="icon"><i class="fa-regular fa-bell"></i></span>
                        <span>Notifications</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn active" type="button" data-target="/DashBoard/Documents">
                        <span class="icon"><i class="fa-regular fa-folder-open"></i></span>
                        <span>Documents</span>
                    </button>
                </li>
                <li>
                    <button class="sidebar-btn" type="button" data-target="/DashBoard/Sales">
                        <span class="icon"><i class="fa-solid fa-chart-column"></i></span>
                        <span>Sales</span>
                    </button>
                </li>
            </ul>
        </aside>

        <main class="dashboard-main documents-main">
            <h1>My Documents</h1>

            <div class="documents-section">
                <h2>My Listings</h2>
                @if (Model.Listings != null && Model.Listings.Any())
                {
                    foreach (var listing in Model.Listings)
                    {
                        <div class="listing-group">
                            <h3 class="listing-title">@listing.Titulo</h3>
                            
                            @if (listing.Documents != null && listing.Documents.Any())
                            {
                                <div class="documents-list">
                                    @foreach (var doc in listing.Documents)
                                    {
                                        <div class="document-card">
                                            <div class="document-thumb"></div>
                                            <div class="document-info">
                                                <div class="document-title">@doc.Tipo</div>
                                                <div class="document-sub">@doc.CarTitle</div>
                                            </div>
                                            <div class="document-actions">
                                                <form asp-action="DeleteDocument" method="post" style="display: inline;">
                                                    <input type="hidden" name="docId" value="@doc.Id" />
                                                    <button type="submit" class="btn-danger" onclick="return confirm('Are you sure you want to delete this document?');">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="no-docs">No documents for this listing.</p>
                            }
                            
                            <div class="add-document-form">
                                <form asp-action="AddDocument" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="anuncioId" value="@listing.Id_Anuncio" />
                                    <input type="text" name="tipo" placeholder="Document type" required />
                                    <input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg" required />
                                    <button type="submit" class="btn-secondary">Add Document</button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>No listings found.</p>
                }
            </div>

            <div class="documents-section">
                <h2>My Purchases</h2>
                @if (Model.Purchases != null && Model.Purchases.Any())
                {
                    foreach (var purchase in Model.Purchases)
                    {
                        <div class="listing-group">
                            <h3 class="listing-title">@purchase.CarTitle</h3>
                            
                            @if (purchase.Documents != null && purchase.Documents.Any())
                            {
                                <div class="documents-list">
                                    @foreach (var doc in purchase.Documents)
                                    {
                                        <div class="document-card">
                                            <div class="document-thumb"></div>
                                            <div class="document-info">
                                                <div class="document-title">@doc.Tipo</div>
                                                <div class="document-sub">@doc.CarTitle</div>
                                            </div>
                                            <div class="document-actions">
                                                <a asp-action="DownloadDocument" asp-route-docId="@doc.Id" class="btn-secondary">Download</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="no-docs">No documents available for this purchase.</p>
                            }
                        </div>
                    }
                }
                else
                {
                    <p>No purchases found.</p>
                }
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // dropdown user
            document.addEventListener("click", function (e) {
                const btn = document.getElementById("userMenuBtn");
                const dropdown = document.getElementById("userDropdown");

                if (!btn || !dropdown) return;

                if (btn.contains(e.target)) {
                    dropdown.classList.toggle("show");
                }
                else if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove("show");
                }
            });

            // sidebar + transition
            document.querySelectorAll('.sidebar-btn[data-target]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = this.getAttribute('data-target');
                    var main = document.querySelector('.dashboard-main');
                    if (!url) return;
                    if (main) {
                        main.classList.add('page-transition-out');
                        setTimeout(function () {
                            window.location.href = url;
                        }, 220);
                    } else {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
}
