@model AutoMatch.Models.ViewModel.CreateListingViewModel
@{
    ViewData["Title"] = "Add New Listing";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
}

<!-- Floating Header -->
<div class="floating-header floating-header-dark">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="@Url.Action("Index", "Home")" class="nav-btn">Home</a>
        <a href="@Url.Action("About", "Home")" class="nav-btn">About</a>
        <a href="@Url.Action("Contact", "Home")" class="nav-btn">Contact</a>

        @if (username == null)
        {
            <a href="/Account/Login" class="nav-btn signin">Sign In</a>
        }
        else
        {
            <div class="user-menu-container">
                <div class="user-badge" id="userMenuBtn">
                    <span class="user-name">@username</span>

                    @if (!string.IsNullOrEmpty(Context.Session.GetString("UserProfileImageUrl")))
                    {
                        <img src="@Context.Session.GetString("UserProfileImageUrl")" class="user-avatar" />
                    }
                    else
                    {
                        <div class="user-avatar">@initial</div>
                    }
                </div>

                <div class="user-dropdown" id="userDropdown">
                    <a href="/Account/Profile">Profile</a>
                    <a href="/Listings/MyListings">My Listings</a>
                    <a href="/Dashboard/Index">Dashboard</a>
                    <a href="/Account/Logout" style="color: red;">Logout</a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Create Car Listing layout -->
<div class="create-page-wrapper">
    <div class="create-card">
        <div class="create-card-header">
            <h1 class="create-card-title">Create Car Listing</h1>
        </div>

        <form asp-action="Create" asp-controller="Listings" method="post" class="create-form" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="create-card-body">
                <div class="create-card-left">
                    <h3 class="create-section-title">Car</h3>

                    <div class="create-row-two">
                        <div class="create-field">
                            <label asp-for="Marca"></label>
                            <select asp-for="Marca" id="brandSelect" class="create-input create-select">
                                <option value="">Brand</option>
                                @foreach (var marca in (IEnumerable<string>)ViewBag.Marcas)
                                {
                                    <option value="@marca">@marca</option>
                                }
                            </select>
                            <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>
                        <div class="create-field">
                            <label asp-for="Modelo"></label>
                            <select asp-for="Modelo" id="modelSelect" class="create-input create-select" disabled>
                                <option value="">Model</option>
                                @foreach (var m in (IEnumerable<AutoMatch.Models.Modelo>)ViewBag.TodosModelos)
                                {
                                    <option value="@m.NomeModelo" data-marca="@m.Marca">@m.NomeModelo</option>
                                }
                            </select>
                            <span asp-validation-for="Modelo" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="create-row-two">
                        <div class="create-field">
                            <label asp-for="Tipo"></label>
                            <select asp-for="Tipo" class="create-input create-select">
                                <option value="">Type</option>
                                @foreach (var tipo in (IEnumerable<string>)ViewBag.Tipos)
                                {
                                    <option value="@tipo">@tipo</option>
                                }
                            </select>
                            <span asp-validation-for="Tipo" class="text-danger"></span>
                        </div>
                        <div class="create-field">
                            <label>Transmission</label>
                            <select name="Transmission" class="create-input create-select">
                                <option value="">Transmission</option>
                                <option value="automatic">Automatic</option>
                                <option value="manual">Manual</option>
                            </select>
                        </div>
                    </div>

                    <div class="create-row-two">
                        <div class="create-field">
                            <label asp-for="Price"></label>
                            <input asp-for="Price" class="create-input" placeholder="30000" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="create-field">
                            <label asp-for="Year"></label>
                            <input asp-for="Year" class="create-input" placeholder="2023" />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="create-field">
                        <label asp-for="Localizacao"></label>
                        <input asp-for="Localizacao" class="create-input" placeholder="Lisbon" />
                        <span asp-validation-for="Localizacao" class="text-danger"></span>
                    </div>

                </div>

                <div class="create-card-right">
                    <div class="photos-panel">
                        <input type="file" id="photoInput" name="Photos" multiple accept="image/*" hidden />
                        <div class="photos-stack">
                            <div class="photo-frame frame-back" data-slot="0">
                                <img id="photoPreview1" class="photo-preview" />
                            </div>
                            <div class="photo-frame frame-middle" data-slot="1">
                                <img id="photoPreview2" class="photo-preview" />
                            </div>
                            <div class="photo-frame frame-front" data-slot="2">
                                <img id="photoPreview3" class="photo-preview" />
                            </div>
                        </div>
                        <div class="photos-label">Photos</div>
                        <div class="photos-controls">
                            <button type="button" class="photos-btn" id="addPhotoBtn">+</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="create-desc-docs-row">
                <div class="create-field">
                    <label asp-for="Descricao"></label>
                    <textarea asp-for="Descricao" rows="5" class="create-input create-textarea" placeholder="Short description of the car..."></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="create-documents-section">
                    <h3 class="create-section-title">Documents</h3>
                    <div class="create-documents-row">
                        <div class="create-field">
                            <label>Type</label>
                            <select name="DocumentType" class="create-input create-select">
                                <option value="">Type</option>
                                <option value="registration">Registration</option>
                                <option value="inspection">Inspection</option>
                                <option value="insurance">Insurance</option>
                            </select>
                        </div>
                        <div class="create-field create-file-field">
                            <label class="sr-only">Upload</label>
                            <div class="create-file-actions">
                                <label class="create-file-button">
                                    <span>Select</span>
                                    <input type="file" name="DocumentFile" hidden />
                                </label>
                                <button type="button" class="create-file-upload">Upload</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="create-actions">
                <button type="submit" name="action" value="save" class="create-btn create-btn-secondary">Save</button>
                <button type="submit" name="action" value="submit" class="create-btn create-btn-primary">Submit</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Dropdown do utilizador
        document.addEventListener("click", function (e) {
            const btn = document.getElementById("userMenuBtn");
            const dropdown = document.getElementById("userDropdown");

            if (!btn || !dropdown) return;

            if (btn.contains(e.target)) {
                dropdown.classList.toggle("show");
            }
            else if (!dropdown.contains(e.target)) {
                dropdown.classList.remove("show");
            }
        });

        // Marca/Modelo dinâmicos com base nos Modelos existentes
        document.addEventListener("DOMContentLoaded", function () {
            const brandSelect = document.getElementById("brandSelect");
            const modelSelect = document.getElementById("modelSelect");
            const addPhotoBtn = document.getElementById("addPhotoBtn");
            const removePhotoBtn = document.getElementById("removePhotoBtn");
            const photoInput = document.getElementById("photoInput");
            if (!brandSelect || !modelSelect) return;

            const allModelOptions = Array.from(modelSelect.querySelectorAll("option[data-marca]"));

            let selectedSlot = 2; // por omissão, a moldura da frente
            const frames = document.querySelectorAll(".photos-stack .photo-frame");

            frames.forEach(frame => {
                frame.addEventListener("click", function () {
                    frames.forEach(f => f.classList.remove("photo-frame-selected"));
                    frame.classList.add("photo-frame-selected");
                    const slot = frame.getAttribute("data-slot");
                    if (slot !== null) {
                        selectedSlot = parseInt(slot);
                    }
                });
            });

            if (addPhotoBtn && photoInput) {
                addPhotoBtn.addEventListener("click", function () {
                    photoInput.click();
                });
            }

            if (removePhotoBtn) {
                removePhotoBtn.addEventListener("click", function () {
                    const previewIds = ["photoPreview1", "photoPreview2", "photoPreview3"]; 
                    const preview = document.getElementById(previewIds[selectedSlot] || "");
                    if (preview) {
                        preview.src = "";
                    }
                });
            }

            if (photoInput) {
                photoInput.addEventListener("change", function () {
                    const files = Array.from(photoInput.files || []);
                    if (files.length === 0) return;

                    const previews = [
                        document.getElementById("photoPreview1"),
                        document.getElementById("photoPreview2"),
                        document.getElementById("photoPreview3")
                    ];

                    // Se tiver múltiplas imagens, preencher os slots
                    if (files.length > 1) {
                        previews.forEach((preview, index) => {
                            if (!preview) return;
                            const file = files[index];
                            if (file) {
                                const url = URL.createObjectURL(file);
                                preview.src = url;
                            }
                        });
                    } else if (files.length === 1) {
                        // Se tiver apenas 1 imagem, adicionar ao slot selecionado
                        const preview = previews[selectedSlot];
                        if (preview && files[0]) {
                            const url = URL.createObjectURL(files[0]);
                            preview.src = url;
                        }
                    }
                    
                    // Limpar o input para permitir selecionar a mesma imagem novamente
                    photoInput.value = "";
                });
            }

            const selectedBrand = brandSelect.value;
            if (selectedBrand) {
                modelSelect.disabled = false;
                filterModels(selectedBrand);
            }

            brandSelect.addEventListener("change", function () {
                const brand = this.value;
                filterModels(brand);
            });

            function filterModels(brand) {
                modelSelect.innerHTML = '<option value="">Model</option>';
                if (!brand) {
                    modelSelect.disabled = true;
                    return;
                }

                allModelOptions.forEach(opt => {
                    if (opt.getAttribute("data-marca") === brand) {
                        modelSelect.appendChild(opt.cloneNode(true));
                    }
                });
                modelSelect.disabled = false;
            }
        });
    </script>
}
