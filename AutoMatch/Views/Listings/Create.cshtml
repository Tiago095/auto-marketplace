@model CreateListingViewModel

@{
    ViewData["Title"] = "Create Listing";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
}

<link rel="stylesheet" href="~/css/listings.css" />
<link rel="stylesheet" href="~/css/footer.css" />

<div class="floating-header floating-header-dark">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="@Url.Action("Index", "Home")" class="nav-btn">Home</a>
        <a href="@Url.Action("About", "Home")" class="nav-btn">About</a>
        <a href="@Url.Action("Contact", "Home")" class="nav-btn">Contact</a>

        @if (username == null)
        {
            <a href="/Account/Login" class="nav-btn signin">Sign In</a>
        }
        else
        {
            <div class="user-menu-container">
                <div class="user-badge" id="userMenuBtn">
                    <span class="user-name">@username</span>

                    @if (!string.IsNullOrEmpty(Context.Session.GetString("UserProfileImageUrl")))
                    {
                        <img src="@Context.Session.GetString("UserProfileImageUrl")" class="user-avatar" />
                    }
                    else
                    {
                        <div class="user-avatar">@initial</div>
                    }
                </div>

                <div class="user-dropdown" id="userDropdown">
                    <a href="/Account/Profile">Profile</a>
                    <a href="/Listings/MyListings">My Listings</a>
                    <a href="/Dashboard/Index">Dashboard</a>
                    <a href="/Account/Logout" style="color: red;">Logout</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="page-wrapper">
    <div class="listing-container">
        <h1>Create Car Listing</h1>

        <form asp-action="Create" asp-controller="Listings" method="post" enctype="multipart/form-data" onsubmit="enableDisabledFields()">

            <div class="form-section">
                <div class="left-panel">
                    <h2>Car</h2>

                    <div class="form-row">
                        <label>Brand</label>
                        <select asp-for="Marca" id="marca-select" asp-items="ViewBag.Marcas" class="input-select" required>
                            <option value="">Select Brand</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <label>Model</label>
                        <select asp-for="IdModelo" id="modelo-select" class="input-select" required disabled>
                            <option value="">Select Model</option>
                        </select>
                    </div>

                    <div class="form-double-row">
                        <div>
                            <label>Type</label>
                            <select asp-for="Categoria" id="categoria-select" class="input-select" disabled style="background-color: #f5f5f5; cursor: not-allowed;">
                                <option value="">Select Type</option>
                                <option value="SUV">SUV</option>
                                <option value="Sedan">Sedan</option>
                                <option value="Hatchback">Hatchback</option>
                                <option value="Coupe">Coupe</option>
                            </select>
                        </div>
                        <div>
                            <label>Transmission</label>
                            <select asp-for="Transmissao" id="transmissao-select" class="input-select" disabled style="background-color: #f5f5f5; cursor: not-allowed;">
                                <option value="">Select Transmission</option>
                                <option value="Manual">Manual</option>
                                <option value="Automatic">Automatic</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-double-row">
                        <div>
                            <label>Price</label>
                            <input asp-for="Preco" type="number" step="0.01" class="input-text" required />
                        </div>
                        <div>
                            <label>Year</label>
                            <input asp-for="Ano" type="number" class="input-text" required />
                        </div>
                    </div>

                    <div class="form-double-row">
                        <div>
                            <label>Kilometers</label>
                            <input asp-for="Kilometros" type="number" class="input-text" required />
                        </div>
                        <div>
                            <label>Plate</label>
                            <input asp-for="Matricula" class="input-text" maxlength="8" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <label>Fuel Type</label>
                        <select asp-for="Combustivel" id="combustivel-select" class="input-select" disabled style="background-color: #f5f5f5; cursor: not-allowed;">
                            <option value="">Select Fuel Type</option>
                            <option value="Gasolina">Gasolina</option>
                            <option value="Diesel">Diesel</option>
                            <option value="Híbrido">Híbrido</option>
                            <option value="Elétrico">Elétrico</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <label>Description</label>
                        <textarea asp-for="Descricao" class="input-textarea" required></textarea>
                    </div>

                    <div class="form-row">
                        <label>Location</label>
                        <input asp-for="Localizacao" class="input-text" required />
                    </div>
                </div>

                <div class="right-panel">
                    <div class="photos-box">
                        <div class="photos-header">PHOTOS</div>

                        <div class="photos-stack">
                            <div class="photo-card card-1" onclick="selectCard(0)">
                                <input asp-for="Imagens" type="file" id="file-input-0" class="hidden" accept="image/*" onchange="handleImageSelect(0, event)">
                                <div class="photo-placeholder">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                    </svg>
                                    <span>1</span>
                                </div>
                            </div>

                            <div class="photo-card card-2" onclick="selectCard(1)">
                                <input asp-for="Imagens" type="file" id="file-input-1" class="hidden" accept="image/*" onchange="handleImageSelect(1, event)">
                                <div class="photo-placeholder">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                    </svg>
                                    <span>2</span>
                                </div>
                            </div>

                            <div class="photo-card card-3" onclick="selectCard(2)">
                                <input asp-for="Imagens" type="file" id="file-input-2" class="hidden" accept="image/*" onchange="handleImageSelect(2, event)">
                                <div class="photo-placeholder">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                    </svg>
                                    <span>3</span>
                                </div>
                            </div>

                            <div class="photo-card card-4" onclick="selectCard(3)">
                                <input asp-for="Imagens" type="file" id="file-input-3" class="hidden" accept="image/*" onchange="handleImageSelect(3, event)">
                                <div class="photo-placeholder">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                    </svg>
                                    <span>4</span>
                                </div>
                            </div>

                            <div class="photo-card card-5" onclick="selectCard(4)">
                                <input asp-for="Imagens" type="file" id="file-input-4" class="hidden" accept="image/*" onchange="handleImageSelect(4, event)">
                                <div class="photo-placeholder">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                    </svg>
                                    <span>5</span>
                                </div>
                            </div>
                        </div>

                        <div class="photo-buttons">
                            <button type="button" class="plus-btn" id="plusBtn">+</button>
                            <button type="button" class="minus-btn" id="minusBtn">−</button>
                        </div>

                        <div class="upload-instructions">
                            <p>Click on a photo slot to select it</p>
                            <p>Then use + to add or - to remove image</p>
                        </div>
                    </div>

                    <h2>Documents</h2>

                    <div class="docs-row">
                        <label>Documents (optional)</label>
                        <input asp-for="Documentos" type="file" name="Documentos" multiple accept=".pdf,.png,.jpg,.jpeg" class="input-text" />
                    </div>

                    <div class="action-row">
                        <button type="submit" class="save-btn">Save</button>
                        <a href="/Listings/MyListings" class="cancel-btn">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_Footer")

<script>
    const modelos = JSON.parse('@Html.Raw(ViewBag.ModelosJson)');

    const marcaSelect = document.getElementById('marca-select');
    const modeloSelect = document.getElementById('modelo-select');
    const categoriaSelect = document.getElementById('categoria-select');
    const transmissaoSelect = document.getElementById('transmissao-select');
    const combustivelSelect = document.getElementById('combustivel-select');

    marcaSelect.addEventListener('change', () => {
        const marca = marcaSelect.value;
        
        if (!marca) {
            // Se não houver marca selecionada, desabilitar modelo e limpar campos (sempre bloqueados)
            modeloSelect.innerHTML = '<option value="">Select Model</option>';
            modeloSelect.disabled = true;
            categoriaSelect.value = '';
            transmissaoSelect.value = '';
            combustivelSelect.value = '';
            return;
        }

        // Habilitar modelo e preencher opções
        modeloSelect.innerHTML = '<option value="">Select Model</option>';
        modeloSelect.disabled = false;

        modelos
            .filter(m => m.Marca === marca)
            .forEach(m => {
                const option = document.createElement('option');
                option.value = m.Id_Modelo;
                option.text = m.NomeModelo;
                modeloSelect.add(option);
            });

        // Limpar campos quando a marca muda (sempre bloqueados)
        categoriaSelect.value = '';
        transmissaoSelect.value = '';
        combustivelSelect.value = '';
    });

    modeloSelect.addEventListener('change', () => {
        const modeloId = parseInt(modeloSelect.value);
        if (!modeloId) {
            categoriaSelect.value = '';
            transmissaoSelect.value = '';
            combustivelSelect.value = '';
            return;
        }

        const modelo = modelos.find(m => m.Id_Modelo === modeloId);
        if (modelo) {
            // Preencher Categoria (Type) - sempre bloqueado
            const categoriaValue = (modelo.Categoria || '').trim();
            categoriaSelect.value = categoriaValue;
            
            // Se a categoria não existir nas opções, criar dinamicamente
            const categoriaExists = Array.from(categoriaSelect.options).some(opt => opt.value === categoriaValue);
            if (!categoriaExists && categoriaValue) {
                const newOption = document.createElement('option');
                newOption.value = categoriaValue;
                newOption.text = categoriaValue;
                categoriaSelect.appendChild(newOption);
                categoriaSelect.value = categoriaValue;
            }

            // Preencher Transmissao (Transmission) - sempre bloqueado
            // modelo.Transmissao é boolean: true = Automatic, false = Manual
            transmissaoSelect.value = modelo.Transmissao ? 'Automatic' : 'Manual';

            // Preencher Combustivel (Fuel Type) - sempre bloqueado
            // Remover espaços e garantir correspondência exata
            const combustivelValue = (modelo.Combustivel || '').trim();
            
            // Verificar se a opção existe antes de definir o valor
            let combustivelExists = Array.from(combustivelSelect.options).some(opt => opt.value === combustivelValue);
            
            if (!combustivelExists && combustivelValue) {
                // Criar a opção dinamicamente se não existir
                const newOption = document.createElement('option');
                newOption.value = combustivelValue;
                newOption.text = combustivelValue;
                combustivelSelect.appendChild(newOption);
                combustivelExists = true;
            }
            
            // Habilitar temporariamente para definir o valor, depois desabilitar novamente
            if (combustivelExists && combustivelValue) {
                combustivelSelect.disabled = false;
                combustivelSelect.value = combustivelValue;
                combustivelSelect.disabled = true;
            }
        }
    });

    // Inicializar estado: modelo e campos bloqueados no início
    modeloSelect.disabled = true;
    categoriaSelect.disabled = true;
    transmissaoSelect.disabled = true;
    combustivelSelect.disabled = true;

    // Função para habilitar campos disabled antes do submit (para enviar os valores)
    function enableDisabledFields() {
        modeloSelect.disabled = false;
        // Habilitar temporariamente apenas para enviar os valores, mas visualmente permanecem bloqueados
        categoriaSelect.disabled = false;
        transmissaoSelect.disabled = false;
        combustivelSelect.disabled = false;
    }

    var images = [null, null, null, null, null];
    var selectedIndex = null;

    function selectCard(index) {
        var cards = document.querySelectorAll('.photo-card');

        cards.forEach(function(card) {
            card.classList.remove('selected');
        });

        cards[index].classList.add('selected');
        selectedIndex = index;

        updateButtons();
    }

    function updateButtons() {
        var plusBtn = document.getElementById('plusBtn');
        var minusBtn = document.getElementById('minusBtn');

        if (selectedIndex === null) {
            plusBtn.disabled = true;
            minusBtn.disabled = true;
        } else {
            plusBtn.disabled = images[selectedIndex] !== null;
            minusBtn.disabled = images[selectedIndex] === null;
        }
    }

    function addImageToSelected() {
        if (selectedIndex !== null && images[selectedIndex] === null) {
            document.getElementById('file-input-' + selectedIndex).click();
        }
    }

    function removeImageFromSelected() {
        if (selectedIndex !== null && images[selectedIndex] !== null) {
            images[selectedIndex] = null;
            document.getElementById('file-input-' + selectedIndex).value = '';
            updateCard(selectedIndex);
            updateButtons();
        }
    }

    function handleImageSelect(index, event) {
        var file = event.target.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onloadend = function() {
                images[index] = reader.result;
                updateCard(index);
                updateButtons();
            };
            reader.readAsDataURL(file);
        }
    }

    function updateCard(index) {
        var card = document.querySelectorAll('.photo-card')[index];
        var placeholder = card.querySelector('.photo-placeholder');

        if (images[index]) {
            if (!card.querySelector('img')) {
                var img = document.createElement('img');
                card.appendChild(img);
            }
            card.querySelector('img').src = images[index];
            placeholder.style.display = 'none';
            card.classList.add('has-image');
        } else {
            var img = card.querySelector('img');
            if (img) img.remove();
            placeholder.style.display = 'flex';
            card.classList.remove('has-image');
        }
    }

    document.getElementById('plusBtn').addEventListener('click', function(e) {
        e.preventDefault();
        addImageToSelected();
    });

    document.getElementById('minusBtn').addEventListener('click', function(e) {
        e.preventDefault();
        removeImageFromSelected();
    });

    updateButtons();
</script>