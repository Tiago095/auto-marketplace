@model IEnumerable<AutoMatch.Models.Anuncio>
@{
    ViewData["Title"] = "My Listings";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
}

<link rel="stylesheet" href="~/css/listings.css" />

<!-- Floating Header (same as Contact / Home) -->
<div class="floating-header floating-header-dark">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="@Url.Action("Index", "Home")" class="nav-btn">Home</a>
        <a href="@Url.Action("About", "Home")" class="nav-btn">About</a>
        <a href="@Url.Action("Contact", "Home")" class="nav-btn">Contact</a>

        @if (username == null)
        {
            <a href="/Account/Login" class="nav-btn signin">Sign In</a>
        }
        else
        {
            <div class="user-menu-container">
                <div class="user-badge" id="userMenuBtn">
                    <span class="user-name">@username</span>

                    @if (!string.IsNullOrEmpty(Context.Session.GetString("UserProfileImageUrl")))
                    {
                        <img src="@Context.Session.GetString("UserProfileImageUrl")" class="user-avatar" />
                    }
                    else
                    {
                        <div class="user-avatar">@initial</div>
                    }
                </div>

                <div class="user-dropdown" id="userDropdown">
                    <a href="/Account/Profile">Profile</a>
                    <a href="/Listings/MyListings">My Listings</a>
                    <a href="/Dashboard/Index">Dashboard</a>
                    <a href="/Account/Logout" style="color: red;">Logout</a>
                </div>
            </div>
        }
    </div>
</div>


<!-- My Listings main panel -->
<div class="mylistings-wrapper">
    <div class="mylistings-panel">
        <div class="mylistings-header">
            <h2 class="mylistings-title">My Listings</h2>

            @if (ViewBag.IsSeller == true)
            {
                <a href="/Listings/Create" class="mylistings-add-btn">Add New Listing</a>
            }
            else
            {
                <a class="mylistings-add-btn disabled-btn">Add New Listing</a>
            }
        </div>

        @if (!Model.Any())
        {
            @if (ViewBag.IsSeller != true)
            {

                <div class="seller-info-wrapper">
                    <p class="seller-info-text">
                        You can't add listings yet. Become a seller to get started!
                    </p>

                    <a href="/Forms/SellerForms" class="become-seller-btn">
                        Become a Seller
                    </a>
                </div>
            }
            else
            {
                <div class="mylistings-empty">You don't have any listings yet.</div>
            }
        }
        else
        {
            <div class="mylistings-list">
                @foreach (var anuncio in Model)
                {
                    <div class="mylistings-card">
                        <div class="mylistings-image">
                            @{
                                // ✅ Versão mais simples - ordenar pelo número no início do nome
                                var firstImage = anuncio.Imagens?
                                .Where(i => !string.IsNullOrEmpty(i.CaminhoImagem))
                                .OrderBy(i =>
                                {
                                    try
                                    {
                                        var nomeArquivo = System.IO.Path.GetFileName(i.CaminhoImagem);
                                        var numeroParte = nomeArquivo.Split('_')[0];
                                        return int.Parse(numeroParte);
                                    }
                                    catch
                                    {
                                        return 999;
                                    }
                                })
                                .FirstOrDefault();

                                var imagePath = firstImage != null
                                ? firstImage.CaminhoImagem
                                : Url.Content("~/images/eletric.png");
                            }
                            <img src="@imagePath" alt="@anuncio.Titulo" />
                        </div>
                        <div class="mylistings-main">
                            <div class="mylistings-info">
                                <div class="mylistings-car-title">@anuncio.Titulo</div>
                                <div class="mylistings-car-price">@anuncio.Preco.ToString("N0") €</div>
                            </div>
                            <div class="mylistings-actions">
                                <a href="@Url.Action("Edit", "Listings", new { id = anuncio.Id_Anuncio })"
                                   class="mylistings-btn edit">Edit</a>
                                <form asp-action="Delete" asp-controller="Listings" asp-route-id="@anuncio.Id_Anuncio" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="mylistings-btn delete" onclick="return confirm('Are you sure you want to delete this listing?');">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Dropdown do utilizador (reutilizado)
        document.addEventListener("click", function (e) {
            const btn = document.getElementById("userMenuBtn");
            const dropdown = document.getElementById("userDropdown");

            if (!btn || !dropdown) return;

            if (btn.contains(e.target)) {
                dropdown.classList.toggle("show");
            }
            else if (!dropdown.contains(e.target)) {
                dropdown.classList.remove("show");
            }
        });
    </script>
}