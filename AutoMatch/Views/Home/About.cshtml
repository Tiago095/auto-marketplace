@{
    ViewData["Title"] = "About Us - AutoMatch";
}

<!-- About Us Content -->
<section class="about-section">
    <!-- Floating Header -->
    <div class="floating-header floating-header-dark">
        <div class="logo-text">AutoMatch</div>
        <div class="floating-buttons">
            <a href="@Url.Action("Index", "Home")"><button class="nav-btn">Home</button></a>
            <a href="@Url.Action("About", "Home")"><button class="nav-btn">About</button></a>
            <a href="@Url.Action("Contact", "Home")"><button class="nav-btn">Contact</button></a>
            <button class="nav-btn signin">Sign In</button>
        </div>
    </div>
    <div class="about-container">
        <h1 class="about-title">ABOUT US....</h1>
        
        <div class="about-intro">
            <p>We connect people with the right cars.</p>
            <p>At AutoMatch, we believe that buying or selling a car should be simple, fast and transparent.</p>
        </div>

        <div class="about-content">
            <div class="about-column">
                <h2>Who we are ?</h2>
                <p>We're a team passionate about cars and technology. We created this marketplace to simplify the vehicle buying and selling process, offering a modern, secure, and efficient platform.</p>
            </div>

            <div class="about-column">
                <h2>What we do?</h2>
                <p>At AutoMatch, we simplify the automotive world.</p>
                <p>We help you find verified cars in just a few clicks and sell your vehicle quickly and securely.</p>
                <p>With a modern platform, intelligent search, and direct chat between buyer and seller, we offer complete transparency—no hassle, no hidden fees, just great opportunities.</p>
            </div>
        </div>

        <div class="about-team">
            <h2>Our Team</h2>
            <ul>
                <li>Tiago Ribeiro</li>
                <li>Francisco Rodrigues</li>
                <li>Pedro Vieira</li>
            </ul>
        </div>
    </div>
</section>
