@{
    ViewData["Title"] = "AutoMatch";

    var username = Context.Session.GetString("UserName");
    var initial = Context.Session.GetString("UserInitial");
    var profileImageUrl = Context.Session.GetString("UserProfileImageUrl");
}

<!-- Floating Header -->
<div class="floating-header">
    <div class="logo-text">AutoMatch</div>
    <div class="floating-buttons">
        <a href="@Url.Action("Index", "Home")" class="nav-btn">Home</a>
        <a href="@Url.Action("About", "Home")" class="nav-btn">About</a>
        <a href="@Url.Action("Contact", "Home")" class="nav-btn">Contact</a>

        @if (username == null)
        {
            <a href="/Account/Login" class="nav-btn signin">Sign In</a>
        }
        else
        {
            <!-- USER BADGE + DROPDOWN -->
            <div class="user-menu-container">
                <div class="user-badge" id="userMenuBtn">
                    <span class="user-name">@username</span>
                    @if (!string.IsNullOrEmpty(profileImageUrl))
                    {
                        <img src="@profileImageUrl" class="user-avatar" />
                    }
                    else
                    {
                        <div class="user-avatar">@initial</div>
                    }
                </div>

                <div class="user-dropdown" id="userDropdown">
                    <a href="/Account/Profile">Profile</a>
                    <a href="/Listings/MyListings">My Listings</a>
                    <a href="/Dashboard/Index">Dashboard</a>
                    <a href="/Account/Logout" style="color: red;">Logout</a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Hero Section -->
<section class="hero">
    <img src="~/images/capa.png" alt="Car Image" class="hero-img">
</section>

<!-- Search Section -->
<section class="search-section text-center">
    <h2>Looking for a new car?</h2>
    <p>Browse through the best cars in the market</p>

    <div class="search-bar">
        <select id="brandSelect">
            <option value="">Brand</option>
            <option value="Tesla">Tesla</option>
            <option value="BMW">BMW</option>
            <option value="Audi">Audi</option>
        </select>

        <select id="modelSelect" disabled>
            <option value="">Model</option>
        </select>

        <input type="number" id="yearSelect" placeholder="Year" min="1990" max="2025" oninput="this.value=this.value.slice(0,4)">

        <div class="price-wrapper">
            <input type="text" id="priceInput" placeholder="Max price (€)">
            <i class="fa fa-search search-icon" onclick="performSearch()"></i>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // MODELOS
        document.addEventListener("DOMContentLoaded", function () {
            const brandSelect = document.getElementById("brandSelect");
            const modelSelect = document.getElementById("modelSelect");

            const models = {
                "Tesla": ["Model S", "Model 3", "Model X", "Model Y"],
                "BMW": ["Series 3", "Series 5", "X5", "X7"],
                "Audi": ["A3", "A4", "Q5", "Q7"]
            };

            brandSelect.addEventListener("change", function () {
                const selectedBrand = this.value;
                modelSelect.innerHTML = '<option value="">Model</option>';
                if (selectedBrand && models[selectedBrand]) {
                    models[selectedBrand].forEach(model => {
                        const opt = document.createElement("option");
                        opt.value = model;
                        opt.textContent = model;
                        modelSelect.appendChild(opt);
                    });
                    modelSelect.disabled = false;
                } else {
                    modelSelect.disabled = true;
                }
            });

            // Enter key on inputs
            document.querySelectorAll('#brandSelect, #modelSelect, #yearSelect, #priceInput').forEach(input => {
                input.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        performSearch();
                    }
                });
            });
        });

        function performSearch() {
            const brand = document.getElementById('brandSelect').value;
            const model = document.getElementById('modelSelect').value;
            const year = document.getElementById('yearSelect').value;
            const price = document.getElementById('priceInput').value;

            const params = new URLSearchParams();
            if (brand) params.append('brand', brand);
            if (model) params.append('model', model);
            if (year) params.append('year', year);
            if (price) params.append('maxPrice', price);

            window.location.href = '/Vehicle/Results?' + params.toString();
        }

        // DROPDOWN DO USER
        document.addEventListener("click", function (e) {
            const btn = document.getElementById("userMenuBtn");
            const dropdown = document.getElementById("userDropdown");

            if (!btn || !dropdown) return;

            if (btn.contains(e.target)) {
                dropdown.classList.toggle("show");
            }
            else if (!dropdown.contains(e.target)) {
                dropdown.classList.remove("show");
            }
        });
    </script>
}

<!-- Featured Cars -->
<section class="featured text-center">
    <h3>Featured Cars</h3>
    <div class="featured-cars">
        <div class="car-card" onclick="window.location.href='/Vehicle/Results?fuelType=Electric'">
            <img src="~/images/eletric.png" alt="Electric Car">
            <div class="car-info">
                <p>Electric</p>
                <span>30,000 €</span>
            </div>
        </div>
        <div class="car-card" onclick="window.location.href='/Vehicle/Results?bodyType=SUV'">
            <img src="~/images/SUV_e.png" alt="SUV">
            <div class="car-info">
                <p>SUV</p>
                <span>50,000 €</span>
            </div>
        </div>
        <div class="car-card" onclick="window.location.href='/Vehicle/Results?maxPrice=80000'">
            <img src="~/images/sports.png" alt="Sports">
            <div class="car-info">
                <p>Sports</p>
                <span>80,000 €</span>
            </div>
        </div>
    </div>
</section>

<!-- Browse by Category -->
<section class="categories text-center">
    <h3>Browse by Category</h3>
    <div class="category-grid">
        <div class="category-card" onclick="window.location.href='/Vehicle/Results?bodyType=SUV'"><img src="~/images/sedan.png"><p>SUV</p></div>
        <div class="category-card" onclick="window.location.href='/Vehicle/Results?bodyType=Sedan'"><img src="~/images/coupe.png"><p>Sedan</p></div>
        <div class="category-card" onclick="window.location.href='/Vehicle/Results?bodyType=Coupe'"><img src="~/images/SUV.png"><p>Coupe</p></div>
        <div class="category-card" onclick="window.location.href='/Vehicle/Results?bodyType=Hatchback'"><img src="~/images/hatchback.png"><p>Hatchback</p></div>
        <div class="category-arrow" onclick="window.location.href='/Vehicle/Results'">➤</div>
    </div>
</section>
